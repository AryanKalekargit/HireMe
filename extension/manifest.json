{
    "manifest_version": 3,
    "name": "HireMe - AI Job Assistant for LinkedIn",
    "version": "1.0.2",
    "description": "Instant AI Resume Match & Hire Score assistant for LinkedIn Job Postings.",
    "permissions": [
        "activeTab",
        "tabs",
        "scripting",
        "storage",
        "cookies"
    ],
    "host_permissions": [
        "https://*.linkedin.com/*",
        "https://hireme-aryan.vercel.app/*",
        "http://localhost:3000/*"
    ],
    "icons": {
        "16": "icons/icon16.png",
        "32": "icons/icon32.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    },
    "action": {
        "default_popup": "popup.html",
        "default_icon": {
            "16": "icons/icon16.png",
            "32": "icons/icon32.png",
            "48": "icons/icon48.png",
            "128": "icons/icon128.png"
        }
    },
    "content_scripts": [
        {
            "matches": [
                "https://*.linkedin.com/*"
            ],
            "js": [
                "scraper/job-title.js",
                "scraper/company.js",
                "scraper/description.js",
                "scraper/location.js",
                "scraper/metadata.js",
                "content.js"
            ]
        }
    ]
}
