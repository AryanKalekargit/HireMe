# HireMe Environment Variables Template

# MongoDB Connection String (Atlas cluster or local MongoDB instance)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/hireme?retryWrites=true&w=majority

# Clerk Authentication (Optional - Local demo sessions work without Clerk)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_sample_hireme_key
CLERK_SECRET_KEY=sk_test_sample_hireme_key

# Cloudinary Storage (Optional - Local disk storage fallback works automatically)
CLOUDINARY_CLOUD_NAME=demo
CLOUDINARY_API_KEY=1234567890
CLOUDINARY_API_SECRET=sample_cloudinary_secret
